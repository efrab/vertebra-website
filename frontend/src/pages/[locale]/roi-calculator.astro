---
import Layout from '../../layouts/Layout.astro'
import type {Locale} from '../../i18n/routes'
import '../../styles/webflow-home.css'
import '../../styles/webflow-sections.css'
import '../../styles/webflow-pages.css'

const {locale} = Astro.params as {locale: Locale}

const title =
  locale === 'es'
    ? 'Calculadora de ROI | Vertebra'
    : 'ROI Calculator | Vertebra'
const description =
  locale === 'es'
    ? 'Calcula cuánto pierde tu operación inmobiliaria cada mes y el ROI de administrar tu portafolio con Vertebra.'
    : 'Calculate how much your real estate operation loses every month and the ROI of managing your portfolio with Vertebra.'
---

<Layout locale={locale} title={title} description={description} routeKey="roiCalculator">
  <section class="header-interna-component" data-wf--header-interna-component--variant="base">
    <div class="header-interna_content" data-vf-reveal="30">
      <img
        src="/assets/webflow/images/Frame-1000005709.svg"
        loading="eager"
        alt=""
        class="header-interna_icon"
        width="40"
        height="40"
      />
      <h1 class="header_title">
        {locale === 'es' ? (
          <>Cuánto te cuesta<br/>administrar <span style="color: var(--_brands---green)">a mano</span></>
        ) : (
          <>How much it costs you<br/>to manage <span style="color: var(--_brands---green)">by hand</span></>
        )}
      </h1>
      <p style="color: rgba(255,255,255,0.65); font-size: 1rem; max-width: 36rem; margin: 0.75rem auto 0;">
        {locale === 'es'
          ? 'Ajusta tu portafolio y compara tu costo mensual con Vertebra contra lo que hoy gastas en procesos manuales.'
          : 'Adjust your portfolio and compare your monthly cost with Vertebra against what you currently spend on manual processes.'}
      </p>
    </div>
    <div class="header-interna_bg" aria-hidden="true">
      <img
        src="/assets/webflow/images/background-1.png"
        srcset="/assets/webflow/images/background-1-p-500.png 500w, /assets/webflow/images/background-1-p-800.png 800w, /assets/webflow/images/background-1-p-1080.png 1080w, /assets/webflow/images/background-1.png 1440w"
        sizes="(max-width: 1200px) 100vw, 1200px"
        loading="eager"
        fetchpriority="high"
        alt=""
        class="header-interna_bg-img"
        width="1440"
        height="400"
      />
    </div>
  </section>

  <section class="relative z-10 -mt-8 pb-12 sm:-mt-16 sm:pb-20">
    <div class="container-page flex flex-col gap-6">
      <div class="grid grid-cols-1 gap-5 sm:gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.12fr)] lg:items-stretch">

        <div class="flex flex-col rounded-[18px] bg-white p-5 shadow-soft sm:p-8">
          <h2 class="roi-panel-title mb-6 text-center text-brand sm:mb-8">
            {locale === 'es' ? 'Tu portafolio' : 'Your portfolio'}
          </h2>

          <div class="mt-6 mb-6">
            <div class="mb-2.5 flex items-baseline justify-between gap-3">
              <label for="comRange" class="text-[15px] font-medium">
                <span class="mr-2 inline-block h-2 w-2 rounded-full bg-brand align-middle"></span>
                {locale === 'es' ? 'Propiedades comerciales' : 'Commercial properties'}
              </label>
              <span class="num text-xs text-muted">USD 5 / {locale === 'es' ? 'mes c/u' : 'mo each'}</span>
            </div>
            <div class="flex items-center gap-4">
              <input type="range" id="comRange" min="0" max="600" step="1" value="80" aria-label={locale === 'es' ? 'Propiedades comerciales, deslizador' : 'Commercial properties, slider'} class="roi-range flex-1" />
              <input type="number" id="comNum" min="0" max="100000" step="1" value="80" aria-label={locale === 'es' ? 'Número de propiedades comerciales' : 'Number of commercial properties'} class="roi-number" />
            </div>
          </div>

          <div class="mb-6">
            <div class="mb-2.5 flex items-baseline justify-between gap-3">
              <label for="indRange" class="text-[15px] font-medium">
                <span class="mr-2 inline-block h-2 w-2 rounded-full bg-accent align-middle"></span>
                {locale === 'es' ? 'Propiedades industriales' : 'Industrial properties'}
              </label>
              <span class="num text-xs text-muted">USD 10 / {locale === 'es' ? 'mes c/u' : 'mo each'}</span>
            </div>
            <div class="flex items-center gap-4">
              <input type="range" id="indRange" min="0" max="600" step="1" value="20" aria-label={locale === 'es' ? 'Propiedades industriales, deslizador' : 'Industrial properties, slider'} class="roi-range roi-range--ind flex-1" />
              <input type="number" id="indNum" min="0" max="100000" step="1" value="20" aria-label={locale === 'es' ? 'Número de propiedades industriales' : 'Number of industrial properties'} class="roi-number" />
            </div>
          </div>

          <div class="overflow-hidden rounded-[14px] border border-border">
            <div class="flex items-center justify-between gap-4 border-b border-border bg-neutral-50 px-5 py-4">
              <div>
                <div class="text-sm font-bold text-ink">Plan</div>
                <div class="mt-0.5 text-[12px] font-medium text-brand">{locale === 'es' ? '10% de descuento con pago anual' : '10% discount with annual payment'}</div>
              </div>
              <div class="inline-flex rounded-full border-[1.5px] border-border bg-white p-1" role="group" aria-label={locale === 'es' ? 'Tipo de plan' : 'Plan type'}>
                <button type="button" id="btnMensual" class="roi-seg-btn" aria-pressed="false">{locale === 'es' ? 'Mensual' : 'Monthly'}</button>
                <button type="button" id="btnAnual" class="roi-seg-btn roi-seg-btn--active" aria-pressed="true">{locale === 'es' ? 'Anual −10%' : 'Annual −10%'}</button>
              </div>
            </div>

            <div class="flex flex-col overflow-x-auto px-0 pt-4">
            <table class="w-full border-separate border-spacing-0 text-[12px] sm:text-[13.5px] sm:min-w-[340px]">
              <caption class="sr-only">{locale === 'es' ? 'Desglose mensual por tipo de propiedad' : 'Monthly breakdown by property type'}</caption>
              <thead>
                <tr>
                  <th class="border-b border-border pb-3 text-center text-[10.5px] font-semibold uppercase tracking-[0.1em] text-muted">{locale === 'es' ? 'Desglose mensual' : 'Monthly breakdown'}</th>
                  <th class="border-b border-border pb-3 text-center text-[10.5px] font-semibold uppercase tracking-[0.1em] text-brand">Vertebra</th>
                  <th class="border-b border-border pb-3 text-center text-[10.5px] font-semibold uppercase tracking-[0.1em] text-muted">{locale === 'es' ? 'Proceso manual' : 'Manual process'}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row" id="rowComLabel" class="border-b border-border py-4 text-center text-[13.5px] font-normal normal-case tracking-normal text-ink">{locale === 'es' ? 'Comerciales' : 'Commercial'}</th>
                  <td id="rowComVert" class="border-b border-border py-4 text-center font-semibold tabular-nums text-brand">&mdash;</td>
                  <td id="rowComMan" class="border-b border-border py-4 text-center tabular-nums text-ink">&mdash;</td>
                </tr>
                <tr>
                  <th scope="row" id="rowIndLabel" class="border-b border-border py-4 text-center text-[13.5px] font-normal normal-case tracking-normal text-ink">{locale === 'es' ? 'Industriales' : 'Industrial'}</th>
                  <td id="rowIndVert" class="border-b border-border py-4 text-center font-semibold tabular-nums text-brand">&mdash;</td>
                  <td id="rowIndMan" class="border-b border-border py-4 text-center tabular-nums text-ink">&mdash;</td>
                </tr>
                <tr class="bg-neutral-50">
                  <th scope="row" class="py-4 text-center text-[14px] font-semibold normal-case tracking-normal text-ink">{locale === 'es' ? 'Total' : 'Total'}</th>
                  <td id="rowTotVert" class="py-4 text-center font-semibold tabular-nums text-brand">&mdash;</td>
                  <td id="rowTotMan" class="py-4 text-center font-semibold tabular-nums text-ink">&mdash;</td>
                </tr>
              </tbody>
            </table>
          </div>
          </div>
        </div>

        <div class="flex flex-col rounded-[18px] bg-dark-blue p-5 text-white shadow-[0_8px_30px_rgba(0,0,0,0.25)] ring-1 ring-white/10 sm:p-8" aria-live="polite">
          <h2 class="roi-panel-title mb-6 text-center text-accent sm:mb-8">
            {locale === 'es' ? 'Tu resultado' : 'Your result'}
          </h2>

          <div class="mt-6 border-b border-white/13 pb-4 text-center sm:pb-6">
            <div class="text-[11px] font-medium uppercase tracking-[0.12em] text-white/45">{locale === 'es' ? 'Ahorro estimado al año' : 'Estimated annual savings'}</div>
            <div class="num my-2 text-[clamp(38px,7.2vw,60px)] font-bold leading-none tracking-tight text-accent"><span id="savYear">&mdash;</span></div>
            <div class="num text-[13.5px] text-white/70"><span id="savLine">&mdash;</span></div>
          </div>

          <div class="mt-5 grid grid-cols-1 gap-px overflow-hidden rounded-[14px] bg-white/13 p-0 sm:grid-cols-2 sm:p-0">
            <div class="bg-dark-blue p-5">
              <div class="mb-2 text-[10.5px] font-medium uppercase tracking-[0.1em] text-white/45">{locale === 'es' ? 'Costo Vertebra' : 'Vertebra cost'}</div>
              <div class="num text-[26px] sm:text-[26px] font-semibold tracking-tight"><span id="vertMonth">&mdash;</span></div>
              <div class="mt-1 text-[11px] text-white/70"><span id="vertNote">USD / {locale === 'es' ? 'mes' : 'mo'}</span></div>
            </div>
            <div class="bg-dark-blue p-5">
              <div class="mb-2 text-[10.5px] font-medium uppercase tracking-[0.1em] text-white/45">{locale === 'es' ? 'Costo del proceso manual' : 'Manual process cost'}</div>
              <div class="num text-[26px] sm:text-[26px] font-semibold tracking-tight text-white/70"><span id="manMonth">&mdash;</span></div>
              <div class="mt-1 text-[11px] text-white/45">{locale === 'es' ? 'USD / mes en horas de equipo, errores y omisiones' : 'USD / mo in team hours, errors and omissions'}</div>
            </div>
          </div>

          <div class="roi-meter" role="img" id="meter" aria-label={locale === 'es' ? 'Proporción entre inversión y ahorro' : 'Investment to savings ratio'}>
            <span class="roi-meter__invested" id="barCost" style="width:12%"></span>
            <span class="roi-meter__recovered" id="barSave" style="width:88%"></span>
          </div>
          <div class="my-2 flex justify-between text-[11px] text-white/45">
            <span>{locale === 'es' ? 'Lo que inviertes' : 'What you invest'}</span>
            <span>{locale === 'es' ? 'Lo que recuperas' : 'What you recover'}</span>
          </div>

          <div class="mt-6 flex items-center gap-3 rounded-[14px] border border-accent/28 bg-accent/10 p-3 sm:gap-5 sm:p-5">
            <div class="num text-[28px] sm:text-[34px] font-bold leading-none tracking-tight text-accent whitespace-nowrap">
              <span id="roiMult">&mdash;</span>
            </div>
            <p class="text-[11px] sm:text-[13px] text-white/70">
              {locale === 'es' ? (
                <Fragment>Por cada <b class="font-semibold text-white">USD 1</b> que inviertes en Vertebra, dejas de gastar <b class="font-semibold text-white" id="roiPerDollar">&mdash;</b> en administración manual.</Fragment>
              ) : (
                <Fragment>For every <b class="font-semibold text-white">USD 1</b> you invest in Vertebra, you stop spending <b class="font-semibold text-white" id="roiPerDollar">&mdash;</b> on manual administration.</Fragment>
              )}
            </p>
          </div>

          <p class="mt-auto pt-5 text-[10.5px] leading-relaxed text-white/45 sm:text-[11.5px]">
            <b class="font-medium text-white/70">{locale === 'es' ? 'Cómo se calcula.' : "How it's calculated."}</b>
            {locale === 'es'
              ? ' Vertebra cobra USD 5/mes por propiedad comercial y USD 10/mes por industrial, con una tarifa mínima de USD 200/mes. El costo del proceso manual —USD 40/mes por propiedad comercial y USD 80/mes por industrial— es el benchmark validado de Vertebra sobre portafolios administrados en hoja de cálculo: horas de equipo, errores de facturación, vencimientos no detectados y mantenimiento reactivo. Onboarding único de USD 500, acreditable a tu suscripción.'
              : " Vertebra charges USD 5/mo per commercial property and USD 10/mo per industrial, with a USD 200/mo minimum. The manual process cost —USD 40/mo per commercial and USD 80/mo per industrial — is Vertebra's validated benchmark on spreadsheet-managed portfolios: team hours, billing errors, missed expirations and reactive maintenance. One-time USD 500 onboarding, credited to your subscription."}
          </p>
        </div>
      </div>
    </div>
  </section>

      <section class="bg-white mb-12 sm:mb-16 lg:mb-20">
        <div class="px-4 sm:px-10 lg:vf-padding-global">
          <div class="vf-container-large">
            <div>
              <div class="cta_content" style="position: relative; padding-top: 3rem; padding-bottom: 3rem; justify-content: center;">
                <div class="title_component">
                  <div class="title_wrapper">
                    <img loading="lazy" src="/assets/webflow/images/title-recurso.svg" alt="" class="title_img" />
                    <h2 class="is-text-in" words-slide-from-right text-split>{locale === 'es' ? '¿Quieres el número exacto para tu portafolio?' : 'Want the exact number for your portfolio?'}</h2>
                  </div>
                </div>
                <p>{locale === 'es' ? 'Armamos el business case con tus contratos y operaciones reales, en 30 minutos.' : "We'll build the business case with your contracts and real operations, in 30 minutes."}</p>
                <div class="cta_btns flex flex-col gap-3 sm:flex-row sm:gap-4">
                  <a href="https://wa.me/+51983723379" class="button-blue is-outline w-inline-block" target="_blank" rel="noopener noreferrer">
                    <div class="icon-1x1-small">
                      <svg width="24" height="25" viewBox="0 0 24 25" fill="none" aria-hidden="true">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M20.4626 4.04546C18.2166 1.79746 15.2306 0.558465 12.0496 0.557465C5.49464 0.557465 0.159641 5.89146 0.156641 12.4495C0.155641 14.5455 0.703641 16.5915 1.74464 18.3955L0.0566406 24.5575L6.36064 22.9035C8.09764 23.8515 10.0536 24.3505 12.0436 24.3515H12.0486C18.6026 24.3515 23.9386 19.0165 23.9416 12.4585C23.9436 9.28146 22.7076 6.29246 20.4626 4.04546ZM12.0496 22.3425H12.0456C10.2716 22.3425 8.53264 21.8655 7.01464 20.9645L6.65364 20.7505L2.91264 21.7315L3.91164 18.0835L3.67664 17.7095C2.68664 16.1355 2.16464 14.3165 2.16564 12.4495C2.16764 6.99946 6.60264 2.56546 12.0546 2.56546C14.6946 2.56546 17.1766 3.59546 19.0426 5.46346C20.9086 7.33246 21.9356 9.81546 21.9346 12.4565C21.9316 17.9085 17.4976 22.3425 12.0496 22.3425ZM17.4716 14.9395C17.1746 14.7905 15.7136 14.0715 15.4406 13.9725C15.1686 13.8735 14.9706 13.8235 14.7716 14.1205C14.5726 14.4175 14.0046 15.0875 13.8306 15.2865C13.6576 15.4845 13.4836 15.5095 13.1866 15.3605C12.8896 15.2115 11.9316 14.8985 10.7966 13.8855C9.91364 13.0975 9.31664 12.1245 9.14364 11.8265C8.97064 11.5285 9.12564 11.3685 9.27364 11.2205C9.40764 11.0875 9.57064 10.8735 9.71964 10.6995C9.86964 10.5275 9.91864 10.4035 10.0186 10.2045C10.1176 10.0065 10.0686 9.83247 9.99364 9.68347C9.91864 9.53547 9.32464 8.07246 9.07764 7.47746C8.83664 6.89746 8.59164 6.97646 8.40864 6.96746C8.23564 6.95846 8.03764 6.95746 7.83864 6.95746C7.64064 6.95746 7.31864 7.03146 7.04664 7.32946C6.77464 7.62746 6.00664 8.34647 6.00664 9.80847C6.00664 11.2715 7.07164 12.6845 7.21964 12.8825C7.36764 13.0805 9.31464 16.0825 12.2956 17.3695C13.0046 17.6755 13.5586 17.8585 13.9896 17.9955C14.7016 18.2215 15.3496 18.1895 15.8616 18.1135C16.4326 18.0285 17.6196 17.3945 17.8676 16.7005C18.1156 16.0065 18.1156 15.4105 18.0406 15.2875C17.9666 15.1625 17.7686 15.0885 17.4716 14.9395Z" fill="#43EA51"></path>
                      </svg>
                    </div>
                    <div>{locale === 'es' ? 'Escríbenos por WhatsApp' : 'Message us on WhatsApp'}</div>
                  </a>
                  <a href="https://calendly.com/josepablot/30min" class="button-blue is-icon w-inline-block" target="_blank" rel="noopener noreferrer">
                    <div>{locale === 'es' ? 'Agendar demo' : 'Book a demo'}</div>
                    <svg class="button-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </a>
                </div>
                <p class="mt-8 text-center text-[11.5px] leading-relaxed text-muted">
                  {locale === 'es'
                    ? 'Cifras en USD, con fines ilustrativos. El ahorro real depende del tamaño del equipo, la complejidad de los contratos y los procesos actuales.'
                    : 'Figures in USD, for illustrative purposes. Actual savings depend on team size, contract complexity and current processes.'}
                  <br />
                  &copy; Vertebra &middot; vertebra.co
                </p>
                <div class="cta_bg" style="position: absolute; inset: 0; z-index: -1; overflow: hidden; border-radius: 1rem;">
                  <img
                    loading="lazy"
                    src="/assets/webflow/images/Frame-1000005638-1.png"
                    srcset="/assets/webflow/images/Frame-1000005638-1-p-500.png 500w, /assets/webflow/images/Frame-1000005638-1-p-800.png 800w, /assets/webflow/images/Frame-1000005638-1.png 1200w"
                    sizes="100vw"
                    alt=""
                    class="cta_fondovf"
                    style="width: 100%; height: 100%; object-fit: cover; object-position: center;"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
</Layout>

<style>
  /* ── header-interna styles (scoped to avoid global side-effects) ── */
  .header-interna-component {
    background-color: transparent;
    justify-content: flex-end;
    align-items: center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 6rem;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .header-interna_bg {
    z-index: -1;
    position: absolute;
    inset: 0%;
    overflow: hidden;
    pointer-events: none;
  }

  .header-interna_bg-img {
    object-fit: cover;
    object-position: center;
    display: block;
    width: 100%;
    height: 100%;
  }

  .header-interna_content {
    grid-column-gap: 1rem;
    grid-row-gap: 1rem;
    justify-content: center;
    align-items: center;
    padding-top: 2rem;
    padding-bottom: 2rem;
    display: flex;
    flex-direction: column;
    text-align: center;
    width: 100%;
  }

  .header-interna_wrp {
    background-color: #fff0;
    border-radius: 1rem;
    justify-content: space-between;
    align-items: center;
    display: flex;
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .header-interna_icon {
    width: auto;
    height: 2.5rem;
    transform: rotate(90deg);
  }

  .header_title {
    color: var(--_brands---white);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.1;
  }

  @media screen and (max-width: 991px) {
    .header-interna-component {
      background-color: transparent;
      padding-left: 0;
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }
    .header-interna_bg {
      z-index: -1;
      width: 100%;
      height: 100%;
      position: absolute;
      inset: 0%;
    }
    .header-interna_bg-img {
      object-fit: cover;
      width: 100%;
      height: 100%;
    }
    .header-interna_wrp {
      background-color: #fff0;
      position: relative;
      overflow: hidden;
    }
  }

  @media screen and (max-width: 479px) {
    .header-interna-component {
      flex-flow: column;
      padding-top: 0;
      padding-bottom: 0;
    }
    .header-interna_content {
      flex-flow: column;
      justify-content: center;
      align-items: center;
      padding-top: 0;
      padding-bottom: 3rem;
    }
    .header-interna_wrp {
      flex-flow: column;
      padding-top: 0;
    }
    .header_title {
      font-size: 1.75rem;
    }
  }

  /* Override the global h2 font-size from webflow-sections.css for panel titles only */
  h2:not(.is-text-in) {
    font-size: inherit;
  }

  .roi-panel-title {
    font-size: var(--text-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
  }

  .roi-range {
    -webkit-appearance: none;
    appearance: none;
    min-width: 0;
    height: 6px;
    border-radius: 99px;
    background: var(--color-border);
    outline: none;
    cursor: pointer;
  }
  .roi-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-white);
    border: 3px solid var(--color-brand);
    box-shadow: 0 2px 8px rgba(20, 27, 77, 0.25);
    cursor: pointer;
  }
  .roi-range::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-white);
    border: 3px solid var(--color-brand);
    box-shadow: 0 2px 8px rgba(20, 27, 77, 0.25);
    cursor: pointer;
  }
  .roi-range--ind::-webkit-slider-thumb {
    border-color: #17b830;
  }
  .roi-range--ind::-moz-range-thumb {
    border-color: #17b830;
  }

  .roi-number {
    width: 94px;
    font-family: inherit;
    font-size: 17px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
    text-align: center;
    padding: 10px 8px;
    border: 1.5px solid var(--color-border);
    border-radius: 11px;
    background: var(--color-neutral-50);
    outline: none;
    -moz-appearance: textfield;
  }
  .roi-number::-webkit-outer-spin-button,
  .roi-number::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .roi-number:focus {
    border-color: var(--color-brand);
  }

  .roi-seg-btn {
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-muted);
    background: none;
    border: none;
    padding: 8px 18px;
    border-radius: 99px;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease;
    white-space: nowrap;
  }
  .roi-seg-btn--active {
    background: var(--color-brand);
    color: #fff;
  }

  .roi-meter {
    height: 10px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
    display: flex;
  }
  .roi-meter__invested {
    display: block;
    height: 100%;
    background: var(--color-brand);
    transition: width 0.35s ease;
  }
  .roi-meter__recovered {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transition: width 0.35s ease;
  }

  /* ── Responsive adjustments ── */
  @media screen and (max-width: 991px) {
    .roi-number {
      width: 80px;
      font-size: 15px;
      padding: 8px 6px;
    }
    .roi-seg-btn {
      font-size: 12px;
      padding: 6px 14px;
    }
  }

  @media screen and (max-width: 767px) {
    .roi-number {
      width: 70px;
      font-size: 14px;
      padding: 8px 4px;
    }
    .roi-seg-btn {
      font-size: 11px;
      padding: 6px 12px;
    }
  }
</style>

<script>
;(function () {
  var PRICE = {com: 5, ind: 10}
  var MANUAL = {com: 40, ind: 80}
  var MIN_FEE = 200
  var ANNUAL_DISCOUNT = 0.10
  var ANIM_DURATION = 600

  var annual = true
  var el = function (id: string) {
    return document.getElementById(id)!
  }
  var comRange = el('comRange') as HTMLInputElement
  var comNum = el('comNum') as HTMLInputElement
  var indRange = el('indRange') as HTMLInputElement
  var indNum = el('indNum') as HTMLInputElement

  // ── counter animation state ──
  var counters: Record<string, {start: number; end: number; startTime: number; raf: number}> = {}

  function money(n: number) {
    return 'USD ' + Math.round(n).toLocaleString('en-US')
  }
  function moneyShort(n: number) {
    n = Math.round(n)
    if (n >= 1000000) return 'USD ' + (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M'
    if (n >= 100000) return 'USD ' + Math.round(n / 1000) + 'K'
    return 'USD ' + n.toLocaleString('en-US')
  }
  function count(v: string) {
    var parsed = parseInt(v, 10)
    if (isNaN(parsed) || parsed < 0) parsed = 0
    if (parsed > 100000) parsed = 100000
    return parsed
  }
  function easeOutCubic(t: number) {
    return 1 - Math.pow(1 - t, 3)
  }

  function animateCounter(id: string, target: number, fmt: (n: number) => string, duration?: number) {
    var elem = el(id)
    var prev = counters[id]
    var startVal = prev ? prev.end : 0
    var dur = duration ?? ANIM_DURATION

    if (prev) cancelAnimationFrame(prev.raf)

    var start = performance.now()
    counters[id] = {start: startVal, end: target, startTime: start, raf: 0}

    function tick(now: number) {
      var elapsed = now - start
      var progress = Math.min(elapsed / dur, 1)
      var value = startVal + (target - startVal) * easeOutCubic(progress)
      elem.textContent = fmt(value)
      if (progress < 1) {
        counters[id].raf = requestAnimationFrame(tick)
      }
    }
    counters[id].raf = requestAnimationFrame(tick)
  }

  function render(animate: boolean) {
    var com = count(comNum.value)
    var ind = count(indNum.value)
    var total = com + ind

    var listCom = com * PRICE.com
    var listInd = ind * PRICE.ind
    var list = listCom + listInd
    var rate = annual ? 1 - ANNUAL_DISCOUNT : 1
    var vertRaw = list * rate
    var vert = total === 0 ? 0 : Math.max(vertRaw, MIN_FEE)
    var minApplied = total > 0 && vertRaw < MIN_FEE

    var scale = list > 0 ? vert / list : 0
    var vertCom = listCom * scale
    var vertInd = listInd * scale

    var manCom = com * MANUAL.com
    var manInd = ind * MANUAL.ind
    var man = manCom + manInd

    var save = Math.max(man - vert, 0)
    var roi = vert > 0 ? man / vert : 0
    var saveYr = save * 12

    if (animate) {
      animateCounter('savYear', saveYr, moneyShort)
      animateCounter('vertMonth', vert, money)
      animateCounter('manMonth', man, money)
      if (roi >= 1) {
        animateCounter('roiMult', roi, function (v) {
          return v.toFixed(1).replace(/\.0$/, '') + 'x'
        })
        animateCounter('roiPerDollar', roi, function (v) {
          return 'USD ' + v.toFixed(2)
        })
      } else {
        el('roiMult').textContent = '--'
        el('roiPerDollar').textContent = 'USD 0'
      }
    } else {
      el('savYear').textContent = moneyShort(saveYr)
      el('vertMonth').textContent = money(vert)
      el('manMonth').textContent = money(man)
      if (roi >= 1) {
        el('roiMult').textContent = roi.toFixed(1).replace(/\.0$/, '') + 'x'
        el('roiPerDollar').textContent = 'USD ' + roi.toFixed(2)
      } else {
        el('roiMult').textContent = '--'
        el('roiPerDollar').textContent = 'USD 0'
      }
    }

    el('savLine').textContent =
      total === 0
        ? 'Add properties to see your savings'
        : money(save) + ' / mo · ' + money(saveYr) + ' / yr'

    el('vertNote').textContent =
      'USD / mo' +
      (annual ? ' · billed annually' : '') +
      (minApplied ? ' · USD 200 minimum applies' : '')

    var pctCost = man > 0 ? Math.min((vert / man) * 100, 100) : 100
    el('barCost').style.width = pctCost.toFixed(1) + '%'
    el('barSave').style.width = (100 - pctCost).toFixed(1) + '%'
    el('meter').setAttribute(
      'aria-label',
      'Invest ' + money(vert) + ' to recover ' + money(save) + ' per month'
    )

    el('rowComLabel').textContent = com.toLocaleString('en-US') + ' commercial'
    el('rowIndLabel').textContent = ind.toLocaleString('en-US') + ' industrial'
    el('rowComVert').textContent = money(vertCom)
    el('rowIndVert').textContent = money(vertInd)
    el('rowComMan').textContent = money(manCom)
    el('rowIndMan').textContent = money(manInd)
    el('rowTotVert').textContent = money(vert)
    el('rowTotMan').textContent = money(man)
  }

  function link(range: HTMLInputElement, num: HTMLInputElement) {
    range.addEventListener('input', function () {
      num.value = range.value
      render(true)
    })
    num.addEventListener('input', function () {
      var v = count(num.value)
      range.value = String(Math.min(v, parseInt(range.max, 10)))
      render(true)
    })
    num.addEventListener('blur', function () {
      num.value = String(count(num.value))
      render(true)
    })
  }
  link(comRange, comNum)
  link(indRange, indNum)

  function setPlan(isAnnual: boolean) {
    annual = isAnnual
    el('btnAnual').setAttribute('aria-pressed', String(isAnnual))
    el('btnMensual').setAttribute('aria-pressed', String(!isAnnual))
    el('btnAnual').classList.toggle('roi-seg-btn--active', isAnnual)
    el('btnMensual').classList.toggle('roi-seg-btn--active', !isAnnual)
    render(true)
  }
  el('btnMensual').addEventListener('click', function () {
    setPlan(false)
  })
  el('btnAnual').addEventListener('click', function () {
    setPlan(true)
  })

  render(false)
})()
</script>
