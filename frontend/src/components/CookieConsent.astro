---
import type {Locale} from '../i18n/routes'
import {t} from '../i18n'

interface Props {
  locale: Locale
}

const {locale} = Astro.props
---

<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-[90] hidden border-t border-ghost bg-white p-4 shadow-[0_-8px_30px_rgba(20,27,77,0.12)]"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie consent"
  data-cookie-consent
>
  <div class="container-page flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="max-w-2xl text-sm text-dark-blue">{t(locale, 'cookie.message')}</p>
    <div class="flex flex-wrap gap-2">
      <button
        type="button"
        class="min-h-11 rounded-md border border-dark-blue px-4 text-sm font-medium text-dark-blue"
        data-cookie-reject
      >
        {t(locale, 'cookie.reject')}
      </button>
      <button
        type="button"
        class="min-h-11 rounded-md bg-brand px-4 text-sm font-medium text-white"
        data-cookie-accept
      >
        {t(locale, 'cookie.accept')}
      </button>
    </div>
  </div>
</div>

<script>
  const KEY = 'vf-cookie-consent'
  const banner = document.querySelector<HTMLElement>('[data-cookie-consent]')
  const accept = document.querySelector('[data-cookie-accept]')
  const reject = document.querySelector('[data-cookie-reject]')

  function setConsent(value: 'accepted' | 'rejected') {
    localStorage.setItem(KEY, value)
    banner?.classList.add('hidden')
    window.dispatchEvent(new CustomEvent('vf:consent', {detail: {value}}))
  }

  const existing = localStorage.getItem(KEY)
  if (existing) {
    window.dispatchEvent(new CustomEvent('vf:consent', {detail: {value: existing}}))
  } else {
    // Defer banner so mobile Speed Index isn't tanked by a late white strip
    const show = () => banner?.classList.remove('hidden')
    const schedule =
      'requestIdleCallback' in window
        ? (cb: () => void) => window.requestIdleCallback(cb, {timeout: 5000})
        : (cb: () => void) => setTimeout(cb, 3500)
    window.addEventListener(
      'load',
      () => {
        setTimeout(() => schedule(show), 2500)
      },
      {once: true},
    )
  }

  accept?.addEventListener('click', () => setConsent('accepted'))
  reject?.addEventListener('click', () => setConsent('rejected'))
</script>
