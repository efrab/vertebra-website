---
import {heroIconPaths, type HeroIconName} from './heroicons'

interface Props {
  name: HeroIconName
  class?: string
  size?: number
}

const {name, class: className = '', size = 28} = Astro.props
const paths = heroIconPaths[name]
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {
    paths.map((d) => (
      <path
        d={d}
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ))
  }
</svg>
