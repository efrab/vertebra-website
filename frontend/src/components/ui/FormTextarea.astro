---
import {formControlClass, type FormSize, type FormTone} from '../../lib/forms'

interface Props {
  tone?: FormTone
  size?: FormSize
  class?: string
  [key: string]: unknown
}

const {tone = 'dark', size = 'md', class: className = '', ...rest} = Astro.props
---

<textarea class={formControlClass(tone, size, `${className} min-h-[8.5rem] resize-y`.trim())} {...rest} />
