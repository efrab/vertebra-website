---
import type {Locale} from '../i18n/routes'
import {getLocalizedPath} from '../i18n/routes'
import ChevronIcon from './ui/ChevronIcon.astro'

interface Props {
  locale: Locale
}

const {locale} = Astro.props
const label = locale === 'es' ? 'Ver cómo automatizar mis propiedades' : 'See how to automate my properties'
---

<div class="vf-sticky-cta" data-sticky-cta>
  <a href={getLocalizedPath(locale, 'agenda')} class="vf-btn vf-btn--green">
    <span>{label}</span>
    <ChevronIcon />
  </a>
</div>

<script>
  // Mobile-only sticky CTA: appears once the hero CTA has scrolled out of view
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]')
  const heroCta = document.querySelector('.vf-heroh .vf-btn--green')
  if (bar && heroCta && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => {
        bar.classList.toggle('is-visible', !entry.isIntersecting)
      },
      {threshold: 0},
    ).observe(heroCta)
  }
</script>
