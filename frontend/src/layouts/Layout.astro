---
import {VisualEditing} from '@sanity/astro/visual-editing'
import {stegaClean} from '@sanity/client/stega'
import '../styles/global.css'
import '../styles/fonts.css'
import type {Locale} from '../i18n/routes'
import {defaultLocale} from '../i18n/routes'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import JsonLd from '../components/seo/JsonLd.astro'
import CookieConsent from '../components/CookieConsent.astro'
import Analytics from '../components/Analytics.astro'
import {loadQuery} from '../lib/sanity/loadQuery'
import {siteSettingsQuery} from '../lib/sanity/queries/settings'
import type {SiteSettings} from '../lib/sanity/types'
import {
  buildCanonicalUrl,
  buildHreflangAlternates,
  ogLocale,
  ogLocaleAlternates,
} from '../lib/seo/hreflang'
import {buildPageStructuredData} from '../lib/seo/structuredData'
import type {LayoutSeoProps} from '../lib/seo/types'
import {getSiteUrl} from '../lib/seo/siteUrl'
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url'
import poppins500 from '@fontsource/poppins/files/poppins-latin-500-normal.woff2?url'
import poppins600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url'
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url'

interface Props extends LayoutSeoProps {
  locale?: Locale
  title: string
  description?: string
  image?: string
  lcpImage?: string
  preloadVideo?: string
  headerAppearance?: 'auto' | 'overlay' | 'solid'
}

const {
  locale = defaultLocale,
  title,
  description,
  image,
  lcpImage,
  preloadVideo,
  headerAppearance = 'auto',
  noindex = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  routeKey,
  alternateSlugs,
  breadcrumbs,
  faqItems,
  includeGlobalSchema = false,
  pageType,
  article,
  service,
} = Astro.props

const siteUrl = getSiteUrl(Astro.url.origin)
const pathname = Astro.url.pathname
const canonicalURL = buildCanonicalUrl({pathname, siteUrl})
const draftMode = Astro.locals.draftMode
const perspectiveCookie = Astro.locals.perspectiveCookie

let siteSettings: SiteSettings | null = null

try {
  siteSettings = await loadQuery<SiteSettings | null>(
    siteSettingsQuery,
    {locale},
    {perspectiveCookie},
  )
} catch {
  // i18n fallbacks in Header/Footer
}

const cleanTitle = stegaClean(title)
const cleanDescription = description ? stegaClean(description) : undefined
const fullTitle = cleanTitle.includes('Vertebra') || cleanTitle.includes('Vértebra')
  ? cleanTitle
  : `${cleanTitle} · Vertebra`

const hreflangAlternates = buildHreflangAlternates({
  locale,
  pathname,
  siteUrl,
  routeKey,
  alternateSlugs,
})

const resolvedOgType = pageType === 'article' ? 'article' : ogType
const robotsContent = noindex || draftMode ? 'noindex, nofollow' : 'index, follow'

const structuredData = buildPageStructuredData({
  locale,
  pathname,
  title: cleanTitle,
  description: cleanDescription,
  image,
  siteSettings,
  includeGlobal: includeGlobalSchema || pageType === 'home',
  breadcrumbs,
  faqItems,
  article: pageType === 'article' ? article : undefined,
  service: pageType === 'service' ? service : undefined,
})

const isTramaLcp = Boolean(lcpImage?.includes('trama-p-'))

const lcpPreloadSrcset = isTramaLcp
  ? '/assets/optimized/trama-p-800.avif'
  : lcpImage && lcpImage.includes('-480.')
    ? `${lcpImage} 480w, ${lcpImage.replace('-480.', '-640.')} 640w, ${lcpImage.replace('-480.', '-1024.')} 1024w`
    : lcpImage && lcpImage.includes('-640.')
      ? `${lcpImage} 640w, ${lcpImage.replace('-640.', '-1024.')} 1024w`
      : undefined

const lcpPreloadType = lcpImage?.endsWith('.avif')
  ? 'image/avif'
  : lcpImage?.endsWith('.webp')
    ? 'image/webp'
    : undefined

const UNI = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
const fontFaces = `@font-face{font-family:'Poppins';font-style:normal;font-display:swap;font-weight:400;src:url(${poppins400}) format('woff2');unicode-range:${UNI}}
@font-face{font-family:'Poppins';font-style:normal;font-display:swap;font-weight:500;src:url(${poppins500}) format('woff2');unicode-range:${UNI}}
@font-face{font-family:'Poppins';font-style:normal;font-display:swap;font-weight:600;src:url(${poppins600}) format('woff2');unicode-range:${UNI}}
@font-face{font-family:'Poppins';font-style:normal;font-display:swap;font-weight:700;src:url(${poppins700}) format('woff2');unicode-range:${UNI}}
@font-face{font-family:'Poppins Fallback';src:local('Arial');size-adjust:112%;ascent-override:93%;descent-override:25%;line-gap-override:0%}`
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces}></style>
    {preloadVideo && (
      <link
        rel="preload"
        as="video"
        href={preloadVideo}
        type="video/mp4"
        media="(min-width: 768px)"
      />
    )}
    {lcpImage && (
      <link
        rel="preload"
        as="image"
        href={isTramaLcp ? '/assets/optimized/trama-p-412.avif' : lcpImage}
        fetchpriority="high"
        media="(max-width: 767px)"
        type={isTramaLcp ? 'image/avif' : lcpPreloadType}
      />
    )}
    {lcpImage && (
      <link
        rel="preload"
        as="image"
        href={isTramaLcp ? '/assets/optimized/trama-p-800.avif' : lcpImage}
        fetchpriority="high"
        media="(min-width: 768px)"
        {...(lcpPreloadType ? {type: lcpPreloadType} : {})}
        {...(!isTramaLcp && lcpPreloadSrcset
          ? {
              imagesrcset: lcpPreloadSrcset,
              imagesizes: '(max-width: 900px) 100vw, 1200px',
            }
          : {})}
      />
    )}
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robotsContent} />

    <link rel="canonical" href={canonicalURL} />
    {hreflangAlternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    {cleanDescription && <meta name="description" content={cleanDescription} />}

    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:site_name" content="Vertebra" />
    <meta property="og:locale" content={ogLocale(locale)} />
    {ogLocaleAlternates(locale).map((altLocale) => (
      <meta property="og:locale:alternate" content={altLocale} />
    ))}
    {cleanDescription && <meta property="og:description" content={cleanDescription} />}
    {image && <meta property="og:image" content={image} />}

    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    {cleanDescription && <meta name="twitter:description" content={cleanDescription} />}
    {image && <meta name="twitter:image" content={image} />}

    <title>{fullTitle}</title>

    <JsonLd data={structuredData} />

    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('.header-item').forEach((element) => {
            element.classList.add('is-header-visible')
          })

          for (const trigger of document.querySelectorAll('[data-reveal-on="load"]')) {
            trigger.querySelectorAll('[data-reveal]').forEach((element) => {
              element.classList.add('is-revealed')
            })
            if (trigger.matches('[data-reveal]')) {
              trigger.classList.add('is-revealed')
            }
          }
        })
      }
    </script>
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-screen flex-col font-sans antialiased">
    {draftMode && <VisualEditing enabled={draftMode} />}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-brand focus:px-4 focus:py-2 focus:text-white">
      Skip to content
    </a>
    <Header locale={locale} appearance={headerAppearance} />
    <main id="main-content" class="flex-1 overflow-x-clip bg-white text-ink">
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieConsent locale={locale} />
    <Analytics />
    <script>
      const boot = () => {
        void import('../scripts/motion')
        void import('../scripts/webflow-home')
        if (document.querySelector('.w-tabs, .w-tab-menu, [data-vf-modulos]')) {
          void import('../scripts/webflow-modulos')
        }
      }
      // Mobile: wait for LCP/SI window before motion runtime
      if (window.matchMedia('(max-width: 767px)').matches) {
        const start = () => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(() => boot(), {timeout: 4000})
          } else {
            setTimeout(boot, 2000)
          }
        }
        if (document.readyState === 'complete') start()
        else window.addEventListener('load', start, {once: true})
      } else {
        boot()
      }
    </script>
  </body>
</html>
