---
interface Item {
  title: string
  description: string
}

interface Props {
  heading: string
  subheading?: string
  items: Item[]
}

const {heading, subheading, items} = Astro.props
---

<section class="seguridad">
  <div class="vf-padding-global padding-global">
    <div class="vf-container-large container-large">
      <div class="padding-section-medium">
        <div class="seguridad_wrp">
          <div class="title_component">
            <div class="title_wrapper">
              <img
                src="/assets/webflow/images/title-recurso.svg"
                loading="lazy"
                alt=""
                class="title_img"
              />
              <h2 words-slide-from-right text-split>{heading}</h2>
              {
                subheading && (
                  <div class="title_prf" data-vf-reveal="30">
                    <p>{subheading}</p>
                  </div>
                )
              }
            </div>
          </div>
          <div class="beneficios_4-grid" data-vf-reveal="30" style="--vf-reveal-delay: 0.15s">
            {
              items.map((item) => (
                <div class="card-v2">
                  <img
                    src="/assets/webflow/images/icon_cardv2.svg"
                    loading="lazy"
                    alt=""
                    class="icon-3-5"
                  />
                  <div class="card_v2_content">
                    <div class="heading-style-h5">{item.title}</div>
                    <div>{item.description}</div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
