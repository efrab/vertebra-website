---
import {t} from '../../i18n'
import type {Locale} from '../../i18n/routes'

interface ContactLink {
  label: string
  href: string
  iconSrc?: string
  variant?: 'outline' | 'blue'
}

interface Props {
  locale: Locale
  heading: string
  description?: string
  formId?: string
  variant?: 'agenda' | 'contact' | 'landing' | 'pricing'
  redirectTo?: string
  formTitle?: string
  formSubtitle?: string
  submitLabel?: string
  sideHeading?: string
  sideDescription?: string
  contactLinks?: ContactLink[]
  showSchedule?: boolean
  requiredNote?: string
}

const {
  locale,
  heading,
  description,
  formId = 'lead-form',
  variant = 'contact',
  redirectTo,
  formTitle,
  formSubtitle,
  submitLabel,
  sideHeading,
  sideDescription,
  contactLinks = [],
  showSchedule = variant === 'agenda',
  requiredNote,
} = Astro.props

const isEn = locale === 'en'
const propertyOptions = isEn
  ? ['1–20', '20–50', '50–100', '100+']
  : ['1 a 20', '20 a 50', '50 a 100', '100 a más']
const hourOptions = ['09:00', '10:00', '11:00', '12:00', '15:00', '16:00', '17:00']
const resolvedFormTitle =
  formTitle || (isEn ? 'Leave us a message' : 'Déjanos un mensaje')
const resolvedFormSubtitle =
  formSubtitle || (isEn ? 'We will reply shortly' : 'Te responderemos a la brevedad')
const resolvedSubmit =
  submitLabel ||
  (variant === 'agenda'
    ? isEn
      ? 'Book my demo'
      : 'Agendar mi demo'
    : t(locale, 'form.submit'))
const resolvedRequired =
  requiredNote || (isEn ? '*Required fields' : '*Campos obligatorios')
const showSide = Boolean(sideHeading || contactLinks.length)
---

{
  description && (
    <section class="herpcenter">
      <div class="padding-global">
        <div class="container-large">
          <div class="padding-section-medium">
            <div class="herpcenter_wrp">
              <div class="title_component _w---medium">
                <div class="title_wrapper _w---medium-2">
                  <img
                    loading="lazy"
                    src="/assets/webflow/images/title-recurso.svg"
                    alt=""
                    class="title_img _w---medium-3"
                  />
                  <h2 words-slide-from-right text-split>{heading}</h2>
                  <div class="title_prf _w---medium-5" data-vf-reveal="30">
                    <p>{description}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="header-interna_bg">
        <img
          sizes="(max-width: 1440px) 100vw, 1440px"
          srcset="/assets/webflow/images/background-1-p-500.png 500w, /assets/webflow/images/background-1-p-800.png 800w, /assets/webflow/images/background-1-p-1080.png 1080w, /assets/webflow/images/background-1.png 1440w"
          alt=""
          loading="lazy"
          src="/assets/webflow/images/background-1.png"
          class="header-interna_bg-img"
        />
      </div>
    </section>
  )
}

<section class="agenda">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-medium">
        <div class="agenda_wrp">
          {
            showSide && (
              <div class="agenda_col" data-vf-reveal="30">
                <div class="title-page is-agenda">
                  <div class="title-page_header is-agenda">
                    <img
                      loading="lazy"
                      src="/assets/webflow/images/icon_title.svg"
                      alt=""
                      class="title-page_icon"
                    />
                    <h1 class="heading-style-h2">{sideHeading}</h1>
                  </div>
                  {
                    sideDescription && (
                      <div class="title-page_content is-left">
                        <div class="text-size-medium">{sideDescription}</div>
                      </div>
                    )
                  }
                  {
                    contactLinks.length > 0 && (
                      <div class="agenda_btns">
                        {contactLinks.map((link) => (
                          <a
                            href={link.href}
                            class:list={[
                              'is-icon',
                              'w-inline-block',
                              link.variant === 'blue' ? 'button-blue' : 'button-outline',
                            ]}
                            target={link.href.startsWith('http') ? '_blank' : undefined}
                            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                          >
                            {link.iconSrc && (
                              <img
                                src={link.iconSrc}
                                loading="lazy"
                                alt=""
                                class="icon-1x1-medium"
                              />
                            )}
                            <div>{link.label}</div>
                            {link.variant === 'blue' && (
                              <div class="icon-1x1-small w-embed">
                                <svg
                                  width="1rem"
                                  height="1rem"
                                  viewBox="0 0 8 16"
                                  fill="none"
                                  xmlns="http://www.w3.org/2000/svg"
                                  aria-hidden="true"
                                >
                                  <path
                                    fill-rule="evenodd"
                                    clip-rule="evenodd"
                                    d="M0.00468612 13.7973C0.00444158 13.6149 0.0403138 13.4343 0.110233 13.2658C0.180049 13.0976 0.282432 12.9449 0.411488 12.8164L4.94313 8.2842C5.03387 8.19349 5.10591 8.08573 5.15502 7.9672C5.20413 7.84867 5.2294 7.72162 5.2294 7.59332C5.2294 7.46502 5.20413 7.33797 5.15502 7.21944C5.10591 7.10091 5.03394 6.99321 4.9432 6.9025L0.419691 2.37958C0.288928 2.2524 0.184541 2.10065 0.112532 1.93302C0.0398879 1.76391 0.00165105 1.58203 5.17332e-05 1.39798C-0.00154759 1.21394 0.0335226 1.03142 0.103217 0.861072C0.172912 0.690724 0.275834 0.535964 0.405978 0.40582C0.536122 0.275676 0.690883 0.172753 0.86123 0.103059C1.03158 0.0333643 1.2141 -0.00170618 1.39814 -0.000106873C1.58219 0.00149243 1.76407 0.039729 1.93318 0.112373C2.1008 0.184378 2.25254 0.288756 2.37972 0.41951L6.90318 4.94238C7.60531 5.64582 8 6.59944 8 7.59332C8 8.5872 7.60566 9.54047 6.90354 10.2439L2.37122 14.7768C2.17738 14.9707 1.93029 15.1029 1.66137 15.1564C1.39241 15.21 1.11362 15.1825 0.860263 15.0776C0.606909 14.9726 0.390383 14.7948 0.238085 14.5668C0.0857871 14.3387 0.00456183 14.0715 0.00468612 13.7973Z"
                                    fill="currentColor"
                                  />
                                </svg>
                              </div>
                            )}
                          </a>
                        ))}
                      </div>
                    )
                  }
                </div>
              </div>
            )
          }

          <div class="agenda_form w-form" data-vf-reveal="1.875em">
            <div class="agenda_form-head">
              <h4>
                <strong>{resolvedFormTitle}</strong>
              </h4>
              <div>{resolvedFormSubtitle}</div>
            </div>
            <form
              id={formId}
              name={formId}
              method="POST"
              action="/api/lead"
              class="agenda_form-cont"
              data-lead-form
              data-variant={variant}
              data-redirect={redirectTo || ''}
            >
              <input type="hidden" name="variant" value={variant} />
              <input type="hidden" name="locale" value={locale} />
              <div class="agenda_form-col">
                <div class="input-fom">
                  <input
                    class="input-fom-input w-input"
                    maxlength="256"
                    name="firstName"
                    placeholder={t(locale, 'form.name')}
                    type="text"
                    required
                    autocomplete="given-name"
                  />
                  <div class="input-fom-txt">{t(locale, 'form.name')}</div>
                </div>
                <div class="input-fom">
                  <input
                    class="input-fom-input w-input"
                    maxlength="256"
                    name="lastName"
                    placeholder={t(locale, 'form.lastName')}
                    type="text"
                    autocomplete="family-name"
                  />
                  <div class="input-fom-txt">{t(locale, 'form.lastName')}</div>
                </div>
              </div>
              <div class="input-fom">
                <input
                  class="input-fom-input w-input"
                  maxlength="256"
                  name="email"
                  placeholder={t(locale, 'form.email')}
                  type="email"
                  required
                  autocomplete="email"
                />
                <div class="input-fom-txt">{t(locale, 'form.email')}</div>
              </div>
              <div class="agenda_form-col is-cel">
                <div class="input-fom">
                  <select name="dialCode" class="input-fom-input w-select">
                    <option value="+52">+52</option>
                    <option value="+51">+51</option>
                    <option value="+1">+1</option>
                    <option value="+57">+57</option>
                  </select>
                </div>
                <div class="input-fom">
                  <input
                    class="input-fom-input w-input"
                    maxlength="256"
                    name="phone"
                    placeholder={t(locale, 'form.phone')}
                    type="tel"
                    autocomplete="tel"
                  />
                  <div class="input-fom-txt">{t(locale, 'form.phone')}</div>
                </div>
              </div>
              <div class="input-fom">
                <select name="properties" class="input-fom-input w-select">
                  <option value="">{t(locale, 'form.properties')}</option>
                  {propertyOptions.map((opt) => (
                    <option value={opt}>{opt}</option>
                  ))}
                </select>
              </div>
              <div class="input-fom is-area">
                <textarea
                  placeholder={t(locale, 'form.message')}
                  maxlength="5000"
                  name="message"
                  class="input-fom-input w-input"
                  rows="4"></textarea>
              </div>
              {
                showSchedule && (
                  <div class="agenda_form-col">
                    <div class="input-fom agenda">
                      <input
                        class="input-fom-input w-input"
                        maxlength="256"
                        name="day"
                        placeholder={isEn ? 'Day' : 'Día'}
                        type="date"
                      />
                      <img
                        src="/assets/webflow/images/heroicons-outlinecalendar.svg"
                        loading="lazy"
                        alt=""
                      />
                    </div>
                    <div class="input-fom">
                      <select name="hour" class="input-fom-input w-select">
                        <option value="">{isEn ? 'Time' : 'Hora'}</option>
                        {hourOptions.map((hour) => (
                          <option value={hour}>{hour}</option>
                        ))}
                      </select>
                    </div>
                  </div>
                )
              }
              <div class="agenda_form-checks">
                <div class="text-color-orange">{resolvedRequired}</div>
                <label class="w-checkbox agenda_form-checktxt">
                  <input
                    type="checkbox"
                    name="privacy"
                    required
                    class="w-checkbox-input"
                  />
                  <span class="w-form-label">{t(locale, 'form.privacy')}</span>
                </label>
              </div>
              <button type="submit" class="button-blue is-icon w-inline-block">
                <div>{resolvedSubmit}</div>
                <div class="icon-1x1-small w-embed">
                  <svg
                    width="1rem"
                    height="1rem"
                    viewBox="0 0 8 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M0.00468612 13.7973C0.00444158 13.6149 0.0403138 13.4343 0.110233 13.2658C0.180049 13.0976 0.282432 12.9449 0.411488 12.8164L4.94313 8.2842C5.03387 8.19349 5.10591 8.08573 5.15502 7.9672C5.20413 7.84867 5.2294 7.72162 5.2294 7.59332C5.2294 7.46502 5.20413 7.33797 5.15502 7.21944C5.10591 7.10091 5.03394 6.99321 4.9432 6.9025L0.419691 2.37958C0.288928 2.2524 0.184541 2.10065 0.112532 1.93302C0.0398879 1.76391 0.00165105 1.58203 5.17332e-05 1.39798C-0.00154759 1.21394 0.0335226 1.03142 0.103217 0.861072C0.172912 0.690724 0.275834 0.535964 0.405978 0.40582C0.536122 0.275676 0.690883 0.172753 0.86123 0.103059C1.03158 0.0333643 1.2141 -0.00170618 1.39814 -0.000106873C1.58219 0.00149243 1.76407 0.039729 1.93318 0.112373C2.1008 0.184378 2.25254 0.288756 2.37972 0.41951L6.90318 4.94238C7.60531 5.64582 8 6.59944 8 7.59332C8 8.5872 7.60566 9.54047 6.90354 10.2439L2.37122 14.7768C2.17738 14.9707 1.93029 15.1029 1.66137 15.1564C1.39241 15.21 1.11362 15.1825 0.860263 15.0776C0.606909 14.9726 0.390383 14.7948 0.238085 14.5668C0.0857871 14.3387 0.00456183 14.0715 0.00468612 13.7973Z"
                      fill="currentColor"
                    />
                  </svg>
                </div>
              </button>
              <p class="w-form-done" data-form-success hidden>{t(locale, 'form.success')}</p>
              <p class="w-form-fail" data-form-error hidden>{t(locale, 'form.error')}</p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      const success = form.querySelector('[data-form-success]')
      const error = form.querySelector('[data-form-error]')
      success?.setAttribute('hidden', '')
      error?.setAttribute('hidden', '')

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        })
        if (!res.ok) throw new Error('fail')
        const redirect = form.dataset.redirect
        if (redirect) {
          window.location.href = redirect
          return
        }
        success?.removeAttribute('hidden')
        form.reset()
      } catch {
        error?.removeAttribute('hidden')
      }
    })
  })
</script>
