---
import ChevronIcon from '../../components/ui/ChevronIcon.astro'

interface PressLogo {
  name: string
  src: string
  href?: string
  small?: boolean
}

interface InvestorLogo {
  name: string
  /** Image logo; omit when using `label` text lockup */
  src?: string
  /** Text lockup (green mark + label) instead of an image */
  label?: string
  href?: string
}

interface Cta {
  label?: string
  href?: string
}

interface Props {
  eyebrow?: string
  heading: string
  headingBold?: string
  headingLight?: string
  subheading?: string
  primaryCta?: Cta
  gifSrc?: string
  pressLabel?: string
  pressLogos?: PressLogo[]
  investorLogos?: InvestorLogo[]
  /** Optimized hero video (preferred over GIF) */
  videoSrc?: string
  posterSrc?: string
  partnerLogos?: {name: string; src?: string}[]
}

const {
  heading,
  headingBold,
  headingLight,
  subheading,
  primaryCta,
  gifSrc = '/assets/webflow/images/63b53ac878b6419d7db66ce4f56d11d3d4aee2bd.gif',
  pressLabel,
  pressLogos = [],
  investorLogos = [],
  videoSrc = '/assets/optimized/63b53ac878b6419d7db66ce4f56d11d3d4aee2bd.mp4',
  posterSrc = '/assets/optimized/63b53ac878b6419d7db66ce4f56d11d3d4aee2bd-poster-720.jpg',
} = Astro.props

const boldPart = headingBold ?? heading
const lightPart = headingLight
const webmSrc = videoSrc.replace(/\.mp4$/, '.webm')

const MARK_SRC = '/assets/webflow/images/icon_title.svg'
---

<section class="vf-heroh">
  <div class="vf-padding-global">
    <div class="vf-container-large">
      <div class="vf-padding-section-medium vf-heroh__inner">
        <div class="vf-heroh__info">
          <div class="vf-title-page">
            <div class="vf-title-page__header">
              <img
                src="/assets/webflow/images/icon_title.svg"
                alt=""
                class="vf-title-page__icon"
                width="40"
                height="40"
                decoding="async"
              />
              <h1 class="vf-title-page__h1">
                {boldPart}
                {lightPart && <span class="is-light"> {lightPart}</span>}
              </h1>
            </div>
            <div class="vf-title-page__content">
              {subheading && <p class="vf-title-page__sub">{subheading}</p>}
              {
                primaryCta?.href && (
                  <a href={primaryCta.href} class="vf-btn vf-btn--green">
                    <span>{primaryCta.label}</span>
                    <ChevronIcon />
                  </a>
                )
              }
            </div>
          </div>

          <div class="vf-heroh__gif" data-vf-reveal="30">
            {
              videoSrc ? (
                <video
                  class="hero_gif-img"
                  width="960"
                  height="784"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={posterSrc}
                >
                  <source src={videoSrc} type="video/mp4" />
                  <source src={webmSrc} type="video/webm" />
                </video>
              ) : (
                <img
                  src={gifSrc}
                  alt=""
                  class="hero_gif-img"
                  width="1024"
                  height="640"
                  loading="eager"
                  decoding="async"
                />
              )
            }
            <div class="vf-heroh__overlay"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="vf-heroh__bg"
    aria-hidden="true"
    data-hero-decor
    data-trama-avif-800="/assets/optimized/trama-p-800.avif"
    data-trama-avif-1200="/assets/optimized/trama-p-1200.avif"
    data-trama-webp-800="/assets/optimized/trama-p-800.webp"
    data-trama-webp-1200="/assets/optimized/trama-p-1200.webp"
    data-colors-avif="/assets/optimized/Group-1000005376-900.avif"
    data-colors-webp="/assets/optimized/Group-1000005376-900.webp"
  >
  </div>
</section>

<script>
  const root = document.querySelector('[data-hero-decor]')
  if (root instanceof HTMLElement) {
    const inject = () => {
      if (root.dataset.ready) return
      root.dataset.ready = '1'
      const tramaAvif800 = root.dataset.tramaAvif800
      const tramaAvif1200 = root.dataset.tramaAvif1200
      const tramaWebp800 = root.dataset.tramaWebp800
      const tramaWebp1200 = root.dataset.tramaWebp1200
      const colorsAvif = root.dataset.colorsAvif
      const colorsWebp = root.dataset.colorsWebp

      root.innerHTML = `
        <picture>
          <source type="image/avif" srcset="${tramaAvif800} 800w, ${tramaAvif1200} 1200w" sizes="(max-width: 900px) 100vw, 1200px" />
          <source type="image/webp" srcset="${tramaWebp800} 800w, ${tramaWebp1200} 1200w" sizes="(max-width: 900px) 100vw, 1200px" />
          <img src="${tramaWebp800}" alt="" class="vf-heroh__fondo" width="800" height="450" decoding="async" />
        </picture>
        <picture>
          <source type="image/avif" srcset="${colorsAvif}" />
          <source type="image/webp" srcset="${colorsWebp}" />
          <img src="${colorsWebp}" alt="" class="vf-heroh__colors" width="900" height="355" decoding="async" />
        </picture>
      `
    }

    // After first paint so H1 on solid brand blue can be LCP
    if ('requestIdleCallback' in window) {
      requestIdleCallback(inject, {timeout: 1200})
    } else {
      window.setTimeout(inject, 200)
    }
  }
</script>
<noscript>
  <style>
    .vf-heroh__bg {
      background-image: url('/assets/optimized/trama-p-800.webp');
      background-size: cover;
      background-position: center;
    }
  </style>
</noscript>

{
  pressLogos.length > 0 && (
    <section class="encuentranos-section">
      <div class="padding-global">
        <div class="container-large is-modulos">
          <div class="padding-section-small">
            <div class="heroh_wrp">
              <div class="heroh_contlogos" data-vf-reveal="1.875em">
                {pressLabel && <div class="text-letter-spacing">{pressLabel}</div>}
                <div class="heroh_logos">
                  {pressLogos.map((logo) => (
                    <a
                      href={logo.href || '#'}
                      class="heroh_logos-link w-inline-block"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={logo.name}
                    >
                      <img
                        src={logo.src}
                        alt={logo.name}
                        class:list={['heroh_logo', logo.small && 'ismall']}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  investorLogos.length > 0 && (
    <section class="logos">
      <div class="padding-global">
        <div class="container-large">
          <div class="logos_wrp" data-vf-reveal="30">
            {[investorLogos.slice(0, 2), investorLogos.slice(2, 4)].map((group) => (
              <div class="logos_box">
                {group.map((logo) =>
                  logo.label ? (
                    <div class="logos_item logos_item--text">
                      <div class="logos_item-lockup">
                        <img
                          src={MARK_SRC}
                          alt=""
                          class="logos_item-lockup-icon"
                          width="36"
                          height="12"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="logos_item-lockup-text">{logo.label}</span>
                      </div>
                    </div>
                  ) : (
                    <a
                      href={logo.href || '#'}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="logos_item w-inline-block"
                      aria-label={logo.name}
                    >
                      <img
                        src={logo.src}
                        alt={logo.name}
                        class="logos_item-img"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  ),
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
