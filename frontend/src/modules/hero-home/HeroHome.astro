---
import ChevronIcon from '../../components/ui/ChevronIcon.astro'

interface PressLogo {
  name: string
  src: string
  href?: string
  small?: boolean
}

interface InvestorLogo {
  name: string
  /** Image logo; omit when using `label` text lockup */
  src?: string
  /** Text lockup (green mark + label) instead of an image */
  label?: string
  href?: string
}

interface Cta {
  label?: string
  href?: string
}

interface Props {
  eyebrow?: string
  heading: string
  headingBold?: string
  headingLight?: string
  subheading?: string
  primaryCta?: Cta
  gifSrc?: string
  pressLabel?: string
  pressLogos?: PressLogo[]
  investorLogos?: InvestorLogo[]
  /** Optimized hero video (preferred over GIF) */
  videoSrc?: string
  posterSrc?: string
  partnerLogos?: {name: string; src?: string}[]
}

const {
  heading,
  headingBold,
  headingLight,
  subheading,
  primaryCta,
  gifSrc = '/assets/webflow/images/63b53ac878b6419d7db66ce4f56d11d3d4aee2bd.gif',
  pressLabel,
  pressLogos = [],
  investorLogos = [],
  videoSrc = '/assets/optimized/63b53ac878b6419d7db66ce4f56d11d3d4aee2bd.mp4',
  posterSrc = '/assets/optimized/63b53ac878b6419d7db66ce4f56d11d3d4aee2bd-poster-720.jpg',
} = Astro.props

const boldPart = headingBold ?? heading
const lightPart = headingLight

const MARK_SRC = '/assets/webflow/images/icon_title.svg'
---

<section class="vf-heroh">
  <div class="vf-padding-global">
    <div class="vf-container-large">
      <div class="vf-padding-section-medium vf-heroh__inner">
        <div class="vf-heroh__info">
          <div class="vf-title-page">
            <div class="vf-title-page__header">
              <img
                src="/assets/webflow/images/icon_title.svg"
                alt=""
                class="vf-title-page__icon"
                width="40"
                height="40"
                decoding="async"
              />
              <h1 class="vf-title-page__h1">
                {boldPart}
                {lightPart && <span class="is-light"> {lightPart}</span>}
              </h1>
            </div>
            <div class="vf-title-page__content">
              {subheading && <p class="vf-title-page__sub">{subheading}</p>}
              {
                primaryCta?.href && (
                  <a href={primaryCta.href} class="vf-btn vf-btn--green">
                    <span>{primaryCta.label}</span>
                    <ChevronIcon />
                  </a>
                )
              }
            </div>
          </div>

          <div class="vf-heroh__gif">
            {
              videoSrc ? (
                <video
                  class="hero_gif-img"
                  width="960"
                  height="720"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster="/assets/optimized/63b53ac878b6419d7db66ce4f56d11d3d4aee2bd-poster-480.jpg"
                  data-hero-video
                  data-poster-desktop={posterSrc}
                >
                  <source
                    src="/assets/optimized/63b53ac878b6419d7db66ce4f56d11d3d4aee2bd-mobile.mp4"
                    type="video/mp4"
                    media="(max-width: 767px)"
                  />
                  <source src={videoSrc} type="video/mp4" media="(min-width: 768px)" />
                  <source src={videoSrc} type="video/mp4" />
                </video>
              ) : (
                <img
                  src={gifSrc}
                  alt=""
                  class="hero_gif-img"
                  width="1024"
                  height="640"
                  decoding="async"
                />
              )
            }
            <div class="vf-heroh__overlay"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="vf-heroh__bg" aria-hidden="true">
    <picture>
      <source
        type="image/avif"
        media="(max-width: 767px)"
        srcset="/assets/optimized/trama-p-480.avif 480w, /assets/optimized/trama-p-640.avif 640w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        media="(max-width: 767px)"
        srcset="/assets/optimized/trama-p-480.webp 480w, /assets/optimized/trama-p-640.webp 640w"
        sizes="100vw"
      />
      <source
        type="image/avif"
        media="(min-width: 768px)"
        srcset="/assets/optimized/trama-p-800.avif 800w, /assets/optimized/trama-p-1200.avif 1200w"
        sizes="(max-width: 900px) 100vw, 1200px"
      />
      <source
        type="image/webp"
        media="(min-width: 768px)"
        srcset="/assets/optimized/trama-p-800.webp 800w, /assets/optimized/trama-p-1200.webp 1200w"
        sizes="(max-width: 900px) 100vw, 1200px"
      />
      <img
        src="/assets/optimized/trama-p-480.webp"
        alt=""
        class="vf-heroh__fondo"
        width="480"
        height="270"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <picture>
      <source
        type="image/avif"
        media="(max-width: 767px)"
        srcset="/assets/optimized/Group-1000005376-450.avif"
      />
      <source
        type="image/webp"
        media="(max-width: 767px)"
        srcset="/assets/optimized/Group-1000005376-450.webp"
      />
      <source
        type="image/avif"
        media="(min-width: 768px)"
        srcset="/assets/optimized/Group-1000005376-900.avif"
      />
      <source
        type="image/webp"
        media="(min-width: 768px)"
        srcset="/assets/optimized/Group-1000005376-900.webp"
      />
      <img
        src="/assets/optimized/Group-1000005376-450.webp"
        alt=""
        class="vf-heroh__colors"
        width="450"
        height="178"
        decoding="async"
      />
    </picture>
  </div>
</section>

{/* Ensure muted autoplay starts; on desktop bump preload for snappier start */}
<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]')
  if (video) {
    const isDesktop = window.matchMedia('(min-width: 768px)').matches
    video.muted = true
    video.defaultMuted = true
    video.setAttribute('muted', '')
    video.setAttribute('playsinline', '')

    if (isDesktop) {
      video.preload = 'auto'
      const desktopPoster = video.dataset.posterDesktop
      if (desktopPoster) video.poster = desktopPoster
    }

    const tryPlay = () => {
      void video.play().catch(() => {})
    }

    if (video.readyState >= 2) tryPlay()
    else video.addEventListener('loadeddata', tryPlay, {once: true})

    video.addEventListener('canplay', tryPlay, {once: true})
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && video.paused) tryPlay()
    })
  }
</script>

{
  pressLogos.length > 0 && (
    <section class="encuentranos-section">
      <div class="padding-global">
        <div class="container-large is-modulos">
          <div class="padding-section-small">
            <div class="heroh_wrp">
              <div class="heroh_contlogos" data-vf-reveal="1.875em">
                {pressLabel && <div class="text-letter-spacing">{pressLabel}</div>}
                <div class="heroh_logos">
                  {pressLogos.map((logo) => (
                    <a
                      href={logo.href || '#'}
                      class="heroh_logos-link w-inline-block"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={logo.name}
                    >
                      <img
                        src={logo.src}
                        alt={logo.name}
                        class:list={['heroh_logo', logo.small && 'ismall']}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  investorLogos.length > 0 && (
    <section class="logos">
      <div class="padding-global">
        <div class="container-large">
          <div class="logos_wrp" data-vf-reveal="30">
            {[investorLogos.slice(0, 2), investorLogos.slice(2, 4)].map((group) => (
              <div class="logos_box">
                {group.map((logo) =>
                  logo.label ? (
                    <div class="logos_item logos_item--text">
                      <div class="logos_item-lockup">
                        <img
                          src={MARK_SRC}
                          alt=""
                          class="logos_item-lockup-icon"
                          width="36"
                          height="12"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="logos_item-lockup-text">{logo.label}</span>
                      </div>
                    </div>
                  ) : (
                    <a
                      href={logo.href || '#'}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="logos_item w-inline-block"
                      aria-label={logo.name}
                    >
                      <img
                        src={logo.src}
                        alt={logo.name}
                        class="logos_item-img"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  ),
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
