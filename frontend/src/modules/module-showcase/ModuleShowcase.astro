import ChevronIcon from '../../components/ui/ChevronIcon.astro'

interface Card {
  title?: string
  description: string
  largeText?: boolean
}

interface ModuleSection {
  title?: string
  description?: string
  imageSrc: string
  imageSrcSet?: string
  cards: Card[]
}

interface ModuleTab {
  id: string
  label: string
  iconSrc?: string
  heading: string
  sections: ModuleSection[]
  message: {line: string; highlight: string}
}

interface Cta {
  heading: string
  description?: string
  primary?: {label: string; href: string}
  secondary?: {label: string; href: string}
  bgSrc?: string
  bgSrcSet?: string
}

interface ModuleItemLegacy {
  title: string
  description: string
  mediaSrc?: string
  mediaType?: 'video' | 'image'
}

interface Props {
  heading: string
  headerIconSrc?: string
  headerBgSrc?: string
  headerBgSrcSet?: string
  tabs?: ModuleTab[]
  cta?: Cta
  /** Legacy Sanity shape (flat modules list) */
  modules?: ModuleItemLegacy[]
}

