---

<section class="hero_modulo">
  <div class="padding-global">
    <div class="container-large is-modulos">
      <div class="padding-section-small">
        <div class="hero_modulos-wrp">
          <div
            class="header-interna-component w-variant-576de604-d99a-8cca-8ac1-d5295aa97b97"
            data-wf--header-interna-component--variant="interna"
          >
            <div class="padding-global">
              <div class="container-large">
                <div class="header-interna_wrp">
                  <div
                    class="header-interna_content w-variant-576de604-d99a-8cca-8ac1-d5295aa97b97"
                    data-vf-reveal="30"
                    style="--vf-reveal-delay: 0.05s"
                  >
                    <img
                      src={headerIconSrc}
                      loading="eager"
                      alt=""
                      class="header-interna_icon"
                      width="40"
                      height="40"
                    />
                    <h1 class="header_title">{heading}</h1>
                  </div>
                </div>
              </div>
            </div>
            <div class="header-interna_bg">
              <img
                src={headerBgSrc}
                srcset={headerBgSrcSet}
                sizes="(max-width: 1200px) 100vw, 1200px"
                loading="eager"
                fetchpriority="high"
                alt=""
                class="header-interna_bg-img"
              />
            </div>
          </div>

          <div class="modulos_wrp">
            <div class="modulos_tab w-tabs" data-vf-tabs data-duration-in="300" data-duration-out="100">
              <div
                class="modulos_tab-menu w-tab-menu"
                role="tablist"
                data-vf-reveal="30"
                style="--vf-reveal-delay: 0.15s"
              >
                {
                  resolvedTabs.map((tab, index) => (
                    <button
                      type="button"
                      role="tab"
                      id={`tab-${tab.id}`}
                      aria-controls={`pane-${tab.id}`}
                      aria-selected={index === 0 ? 'true' : 'false'}
                      tabindex={index === 0 ? 0 : -1}
                      data-w-tab={tab.id}
                      class:list={['modulos_tab-link', 'w-inline-block', 'w-tab-link', index === 0 && 'w--current']}
                    >
                      <div class="code-embed w-embed" aria-hidden="true">
                        {tab.id === 'mantenimiento' ? (
                          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                            {mantenimientoPaths.map((d) => (
                              <path d={d} fill="currentColor" />
                            ))}
                          </svg>
                        ) : iconPaths[tab.id] ? (
                          <svg
                            width="18"
                            height={tab.id === 'metricas' ? '17' : '18'}
                            viewBox={tab.id === 'metricas' ? '0 0 18 17' : '0 0 18 18'}
                            fill="none"
                          >
                            <path d={iconPaths[tab.id]} fill="currentColor" />
                          </svg>
                        ) : tab.iconSrc ? (
                          <img src={tab.iconSrc} alt="" width="18" height="18" />
                        ) : null}
                      </div>
                      <div>{tab.label}</div>
                    </button>
                  ))
                }
              </div>

              <div class="modulos_tab-content w-tab-content">
                {
                  resolvedTabs.map((tab, index) => (
                    <div
                      data-w-tab={tab.id}
                      id={`pane-${tab.id}`}
                      role="tabpanel"
                      aria-labelledby={`tab-${tab.id}`}
                      hidden={index !== 0}
                      class:list={['modulos_tab-pane', 'w-tab-pane', index === 0 && 'w--tab-active']}
                    >
                      <div class="modulos_tab-cont" data-vf-reveal="1.875em">
                        <div class="modulos_subtitle">
                          <h2>{tab.heading}</h2>
                        </div>

                        {tab.sections.map((section) => (
                          <div class="modulos_section">
                            {section.title && <h3>{section.title}</h3>}
                            {section.description && (
                              <p set:html={section.description.replace(/\n/g, '<br />')} />
                            )}
                            <div class="modulos_cols">
                              {section.imageSrc && (
                                <img
                                  loading="lazy"
                                  src={section.imageSrc}
                                  srcset={section.imageSrcSet}
                                  sizes={section.imageSrcSet ? '100vw' : undefined}
                                  alt=""
                                  class="modulos_img"
                                />
                              )}
                              <div class="modulos_info">
                                {section.cards.map((card, cardIndex) => (
                                  <div
                                    class="card-v4"
                                    data-wf--card-v4--variant={card.largeText ? 'texto-grande' : 'base'}
                                    data-vf-reveal="30"
                                    style={`--vf-reveal-delay: ${(0.12 + cardIndex * 0.07).toFixed(2)}s`}
                                  >
                                    <img
                                      src="/assets/webflow/images/icon-cardv4.svg"
                                      loading="lazy"
                                      alt=""
                                      class="icon-1x1-medium"
                                      width="24"
                                      height="24"
                                    />
                                    {card.title && <div class="heading-style-h6">{card.title}</div>}
                                    <div
                                      class:list={[
                                        'text-size-small',
                                        card.largeText && 'w-variant-c4d92a5e-77e1-1e79-8cbf-eb19751afbba',
                                      ]}
                                    >
                                      {card.description}
                                    </div>
                                  </div>
                                ))}
                              </div>
                            </div>
                          </div>
                        ))}

                        {tab.message.line && (
                          <div
                            class="message-component"
                            data-vf-reveal="30"
                            style="--vf-reveal-delay: 0.35s"
                          >
                            <div class="message_box">
                              <img src="/assets/webflow/images/icon-cta.svg" loading="lazy" alt="" width="40" height="40" />
                              <div class="message_txt">
                                <div>{tab.message.line}</div>
                                <h4>{tab.message.highlight}</h4>
                              </div>
                            </div>
                            <img
                              src="/assets/webflow/images/mujer-recortada_1mujer-recortada.png"
                              loading="lazy"
                              alt=""
                              class="message_person"
                            />
                          </div>
                        )}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            {
              cta && (
                <div class="cta_content" data-vf-reveal="30">
                  <div class="title_component">
                    <div class="title_wrapper">
                      <img
                        loading="lazy"
                        src="/assets/webflow/images/title-recurso.svg"
                        alt=""
                        class="title_img"
                      />
                      <h2 words-slide-from-right text-split>
                        {cta.heading}
                      </h2>
                    </div>
                  </div>
                  {cta.description && (
                    <p data-vf-reveal="30" style="--vf-reveal-delay: 0.15s">
                      {cta.description}
                    </p>
                  )}
                  <div class="cta_btns" data-vf-reveal="30" style="--vf-reveal-delay: 0.28s">
                    {cta.secondary && (
                      <a
                        href={cta.secondary.href}
                        class="button-blue is-outline w-inline-block"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <div class="icon-1x1-small">
                          <svg width="24" height="25" viewBox="0 0 24 25" fill="none" aria-hidden="true">
                            <path
                              fill-rule="evenodd"
                              clip-rule="evenodd"
                              d="M20.4626 4.04546C18.2166 1.79746 15.2306 0.558465 12.0496 0.557465C5.49464 0.557465 0.159641 5.89146 0.156641 12.4495C0.155641 14.5455 0.703641 16.5915 1.74464 18.3955L0.0566406 24.5575L6.36064 22.9035C8.09764 23.8515 10.0536 24.3505 12.0436 24.3515H12.0486C18.6026 24.3515 23.9386 19.0165 23.9416 12.4585C23.9436 9.28146 22.7076 6.29246 20.4626 4.04546ZM12.0496 22.3425H12.0456C10.2716 22.3425 8.53264 21.8655 7.01464 20.9645L6.65364 20.7505L2.91264 21.7315L3.91164 18.0835L3.67664 17.7095C2.68664 16.1355 2.16464 14.3165 2.16564 12.4495C2.16764 6.99946 6.60264 2.56546 12.0546 2.56546C14.6946 2.56546 17.1766 3.59546 19.0426 5.46346C20.9086 7.33246 21.9356 9.81546 21.9346 12.4565C21.9316 17.9085 17.4976 22.3425 12.0496 22.3425ZM17.4716 14.9395C17.1746 14.7905 15.7136 14.0715 15.4406 13.9725C15.1686 13.8735 14.9706 13.8235 14.7716 14.1205C14.5726 14.4175 14.0046 15.0875 13.8306 15.2865C13.6576 15.4845 13.4836 15.5095 13.1866 15.3605C12.8896 15.2115 11.9316 14.8985 10.7966 13.8855C9.91364 13.0975 9.31664 12.1245 9.14364 11.8265C8.97064 11.5285 9.12564 11.3685 9.27364 11.2205C9.40764 11.0875 9.57064 10.8735 9.71964 10.6995C9.86964 10.5275 9.91864 10.4035 10.0186 10.2045C10.1176 10.0065 10.0686 9.83247 9.99364 9.68347C9.91864 9.53547 9.32464 8.07246 9.07764 7.47746C8.83664 6.89746 8.59164 6.97646 8.40864 6.96746C8.23564 6.95846 8.03764 6.95746 7.83864 6.95746C7.64064 6.95746 7.31864 7.03146 7.04664 7.32946C6.77464 7.62746 6.00664 8.34647 6.00664 9.80847C6.00664 11.2715 7.07164 12.6845 7.21964 12.8825C7.36764 13.0805 9.31464 16.0825 12.2956 17.3695C13.0046 17.6755 13.5586 17.8585 13.9896 17.9955C14.7016 18.2215 15.3496 18.1895 15.8616 18.1135C16.4326 18.0285 17.6196 17.3945 17.8676 16.7005C18.1156 16.0065 18.1156 15.4105 18.0406 15.2875C17.9666 15.1625 17.7686 15.0885 17.4716 14.9395Z"
                              fill="#43EA51"
                            />
                          </svg>
                        </div>
                        <div>{cta.secondary.label}</div>
                      </a>
                    )}
                    {cta.primary && (
                      <a href={cta.primary.href} class="button-blue is-icon w-inline-block">
                        <div>{cta.primary.label}</div>
                        <ChevronIcon />
                      </a>
                    )}
                  </div>
                  <div class="cta_bg">
                    {cta.bgSrc && (
                      <img
                        src={cta.bgSrc}
                        srcset={cta.bgSrcSet}
                        sizes="(max-width: 1200px) 100vw, 1200px"
                        loading="lazy"
                        alt=""
                        class="cta_fondovf"
                      />
                    )}
                  </div>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
