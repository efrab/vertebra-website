  headerBgSrcSet,
  tabs = [],
  cta,
  modules = [],
} = Astro.props

const resolvedTabs: ModuleTab[] =
  tabs.length > 0
    ? tabs
    : modules.map((mod, i) => ({
        id: `module-${i}`,
        label: mod.title,
        heading: mod.title,
        sections: [
          {
            description: mod.description,
            imageSrc: mod.mediaSrc || '',
