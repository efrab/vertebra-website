---
import HeroIcon from '../../components/ui/HeroIcon.astro'
import type {HeroIconName} from '../../components/ui/heroicons'

interface Item {
  title?: string
  description: string
  iconSrc?: string
  icon?: HeroIconName
}

interface Props {
  heading: string
  subheading?: string
  introLabel?: string
  items: Item[]
}

const {heading, subheading, introLabel, items} = Astro.props
---

<section class="regular">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-medium">
        <div class="regular_wrp">
          <div
            class="title_component w-variant-42da6f63-e88e-e4da-f355-db66a20199ad"
            data-wf--title-section--variant="w---medium"
          >
            <div class="title_wrapper">
              <img
                src="/assets/webflow/images/title-recurso.svg"
                loading="lazy"
                alt=""
                class="title_img"
              />
              <h2 words-slide-from-right text-split>{heading}</h2>
              {
                subheading && (
                  <div class="title_prf" data-vf-reveal="30">
                    <p>{subheading}</p>
                  </div>
                )
              }
            </div>
          </div>
          <div class="eva_wrp">
            {
              introLabel && (
                <div class="text-size-medium text-color-bluedark" data-vf-reveal="30">
                  <strong>{introLabel}</strong>
                </div>
              )
            }
            <div class="layout-4" data-vf-stagger="100">
              {
                items.map((item) => (
                  <div class="card-v1" data-vf-reveal="1.875em">
                    <div class="card_header">
                      {item.icon ? (
                        <span class="icon-4-5 icon-4-5--hero" aria-hidden="true">
                          <HeroIcon name={item.icon} size={24} />
                        </span>
                      ) : (
                        <img
                          src={item.iconSrc || '/assets/webflow/images/almuerzo-cohete-1-1.svg'}
                          loading="lazy"
                          alt=""
                          class="icon-4-5"
                          width="64"
                          height="64"
                        />
                      )}
                    </div>
                    {item.title && <div class="heading-style-h5">{item.title}</div>}
                    <div>{item.description}</div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .icon-4-5--hero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 999px;
    color: #141b4d;
    background: #fff;
    flex-shrink: 0;
  }
</style>
